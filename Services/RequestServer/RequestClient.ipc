#include <LibCore/AnonymousBuffer.h>
#include <LibHTTP/Header.h>
#include <LibRequests/NetworkError.h>
#include <LibRequests/CacheState.h>
#include <LibRequests/RequestTimingInfo.h>
#include <LibURL/URL.h>
#include <RequestServer/RequestType.h>

endpoint RequestClient
{
    retain_response_header_policy(u64 parent_request_id, u64 background_request_id) =|
    release_response_header_policy(u64 background_request_id) =|
    query_canonical_url_policy(u64 request_id, u64 generation, bool background, Vector<URL::URL> aliases, Vector<String> addresses) =|
    query_request_header_policy(u64 request_id, u64 generation, bool background, Vector<HTTP::Header> request_headers, String ip_addresses) =|
    query_response_header_policy(u64 request_id, u64 generation, bool background, Vector<HTTP::Header> response_headers, String ip_addresses) =|
    request_requires_network(u64 request_id) =|
    request_upload_progress(u64 request_id, u64 bytes_sent) =|
    request_started(u64 request_id, IPC::File fd) =|
    request_body_file_available(u64 request_id, IPC::File fd, u64 offset, u64 size) =|
    request_cached_body_file_available(u64 request_id, IPC::File fd, u64 offset, u64 size) =|
    request_finished(u64 request_id, u64 total_size, Requests::RequestTimingInfo timing_info, Optional<Requests::NetworkError> network_error) =|
    headers_became_available(u64 request_id, URL::URL url, Vector<HTTP::Header> response_headers, Optional<u32> status_code, Optional<String> reason_phrase, Requests::CacheState cache_state, ByteString http_version, String canonical_host_names, String ip_addresses) =|
    request_transferred(u64 request_id) =|
    host_resolved(u64 lookup_id, Vector<ByteString> addresses) =|

    // Websocket API
    // FIXME: See if this can be merged with the regular APIs
    query_websocket_canonical_policy(u64 websocket_id, u64 generation, Vector<URL::URL> aliases, Vector<String> addresses) =|
    websocket_connected(u64 websocket_id) =|
    websocket_received(u64 websocket_id, bool is_text, ByteBuffer data) =|
    websocket_received_shared(u64 websocket_id, bool is_text, Core::AnonymousBuffer data) =|
    websocket_transmitted(u64 websocket_id, u64 message_byte_count) =|
    websocket_errored(u64 websocket_id, i32 message) =|
    websocket_closed(u64 websocket_id, u16 code, ByteString reason, bool clean) =|
    websocket_ready_state_changed(u64 websocket_id, u32 ready_state) =|
    websocket_subprotocol(u64 websocket_id, ByteString subprotocol) =|
}
